# Copy this file to .env and fill it in. Real environment variables (set on
# your hosting dashboard) override anything in .env.

# Port the portal listens on.
PORT=3000

# Organiser logins, created the first time the server starts.
# Leave a password blank and a random one is generated and printed in the logs.
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD=
ADMIN1_NAME=Organiser 1

ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=
ADMIN2_NAME=Organiser 2

# Where the database file lives. On cloud hosts, point this at a persistent
# disk/volume (e.g. /data) or your data is lost on every redeploy.
# DATA_DIR=./data

# Number of reverse proxies in front of the app (Railway, Render, nginx = 1).
# Set to 0 when running directly on a laptop or LAN server.
# TRUST_PROXY=1

# How long a sign-in lasts, in days.
# SESSION_DAYS=7
